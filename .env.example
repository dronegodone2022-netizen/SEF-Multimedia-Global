# Client-safe environment variables only.
# Never store passwords, private keys, or tokens in VITE_* variables.

# Google OAuth client ID used by the frontend login flow.
VITE_GOOGLE_CLIENT_ID=

# Optional analytics key for PostHog (public key only).
VITE_PUBLIC_POSTHOG_KEY=

# Optional PostHog host (defaults to https://us.posthog.com)
VITE_PUBLIC_POSTHOG_HOST=https://us.posthog.com

# Optional base path for production assets.
# Use / for Hostinger root deploy, or /SEF-Multimedia-Global/ for GitHub Pages.
VITE_BASE_PATH=/

# Optional Google Apps Script endpoint for bridge integration.
VITE_APPS_SCRIPT_URL=
